# ── Server ──────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_USER_URL=http://localhost:3000
CLIENT_OFFICER_URL=http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/civicsense

# ── JWT Secrets ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Cloudinary (Media Uploads) ────────────────────────────────────────
# Always use long-lived/public URLs — never short-lived pre-signed URLs
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI Microservice (FastAPI) ─────────────────────────────────────────
# Default port is 8001 (the ai-service runs on 8000 locally)
AI_SERVICE_URL=http://localhost:8001

# ── Groq Whisper (audio transcription) ───────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Email (optional) ──────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@civicsense.ai

# ── Twilio (optional) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE=

# ── Cleanup job ────────────────────────────────────────────────────────
HISTORY_RETENTION_DAYS=7
