# ============================================================
# CivicSense AI — Server Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets.
# ============================================================

# ---- Server ----
PORT=5000                        # Express HTTP server port

# ---- MongoDB ----
MONGO_URI=                        # MongoDB connection string (Atlas or local)
                                  # Example: mongodb+srv://user:pass@cluster.mongodb.net/civicsense

# ---- JWT ----
JWT_ACCESS_SECRET=                # Random secret for signing access tokens (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_REFRESH_SECRET=               # Random secret for signing refresh tokens (different from access secret)
JWT_ACCESS_EXPIRES=15m            # Access token expiry (e.g. 15m, 1h)
JWT_REFRESH_EXPIRES=7d            # Refresh token expiry

# ---- Cloudinary (media upload) ----
CLOUDINARY_CLOUD_NAME=            # Cloudinary account cloud name — get from cloudinary.com dashboard
CLOUDINARY_API_KEY=               # Cloudinary API key
CLOUDINARY_API_SECRET=            # Cloudinary API secret

# ---- AI Service (FastAPI) ----
AI_SERVICE_URL=                   # Base URL of the FastAPI ai-service (e.g. http://localhost:8000)

# ---- CORS — Frontend URLs ----
CLIENT_USER_URL=http://localhost:3000      # citizen React/Vite dev URL
CLIENT_OFFICER_URL=http://localhost:5173  # officer React/Vite dev URL

# ---- Email (password reset, optional) ----
EMAIL_HOST=                       # SMTP host (e.g. smtp.gmail.com)
EMAIL_PORT=587                    # SMTP port
EMAIL_USER=                       # SMTP username / sender address
EMAIL_PASS=                       # SMTP password or app-specific password
EMAIL_FROM=noreply@civicsense.ai  # From address shown in emails

# ---- SMS (optional) ----
TWILIO_ACCOUNT_SID=               # Twilio Account SID — get from twilio.com console
TWILIO_AUTH_TOKEN=                # Twilio Auth Token
TWILIO_PHONE=                     # Twilio sender phone number
