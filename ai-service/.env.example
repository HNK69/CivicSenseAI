# ─── CivicSense AI — ai-service environment EXAMPLE ──────────────────────────
# This file is safe to commit. Copy to .env and fill in real values.

# ── Service ────────────────────────────────────────────────────────────────────
SERVICE_NAME=civicsense-ai
SERVICE_VERSION=0.1.0
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Ollama / Gemma ──────────────────────────────────────────────────────────────
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
GEMMA_MODEL=<gemma-model-tag>         # e.g. gemma4:12b
GEMMA_TIMEOUT_SECONDS=300
OLLAMA_PROBE_TIMEOUT_SECONDS=10

# ── BGE-M3 Embeddings ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=bge-m3:latest
EMBEDDING_DIMENSION=1024

# ── FAISS ───────────────────────────────────────────────────────────────────────
FAISS_INDEX_DIR=./data/faiss
FAISS_TOP_K=10

# ── Cloudinary ─────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# ── Media download & processing (/analyze) ─────────────────────────────────────
MAX_IMAGE_BYTES=10485760
MAX_IMAGE_DIMENSION=1024
ANALYZE_MAX_FRAMES=4
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
ANALYZE_NUM_CTX=8192

# ── /detect-duplicates ─────────────────────────────────────────────────────────
DUPLICATE_NUM_CTX=8192
DUPLICATE_SIMILARITY_THRESHOLD=0.3
EMBEDDING_TIMEOUT_SECONDS=30
FAISS_PERSIST_EVERY_WRITE=true
FAISS_INDEX_VERSION=1

# ── Google AI Studio (fallback provider) ────────────────────────────────────────
# Comma-separated API keys — leave empty to run in Ollama-only mode.
# NEVER commit real keys to version control.
GOOGLE_AI_KEYS=
GOOGLE_AI_MODEL=gemma-4-12b-it
GOOGLE_AI_TIMEOUT_SECONDS=120
KEY_COOLDOWN_SECONDS=60

# ── Circuit breaker (guards Ollama) ─────────────────────────────────────────────
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RESET_TIMEOUT=60

# ── Failover budget ──────────────────────────────────────────────────────────────
FAILOVER_BUDGET_SECONDS=120

# ── /verify-repair ───────────────────────────────────────────────────────────────
VERIFY_REPAIR_NUM_CTX=8192
VERIFY_REPAIR_MAX_IMAGES=4
MAX_IMAGE_DIMENSION=1024
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30

# ── /copilot ─────────────────────────────────────────────────────────────────────
COPILOT_NUM_CTX=8192
COPILOT_MAX_TOOL_ITERATIONS=3
